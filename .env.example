# Copy to .env (never commit .env). Read by the backend and by docker compose.
# Everything here is optional on a dev machine: the defaults in backend/app/config.py are used.

# --- Database (docker compose creates Postgres with this password on its FIRST start only) ---
POSTGRES_PASSWORD=sakshi
# Must use the same password. Letters and digits only in the password (@ / # break the URL).
DATABASE_URL=postgresql+psycopg://sakshi:sakshi@localhost:5442/sakshi
REDIS_URL=redis://localhost:6390/0

# --- Security (set on a server) ---
# Signs logins and encrypts saved camera links. Generate once with: openssl rand -hex 32
# NEVER change it afterwards, or saved RTSP links become unreadable.
# SECRET_KEY=

# --- Storage and web ---
# DATA_DIR=/opt/sakshi-verify/data
# CORS_ORIGINS=["https://your-domain.com"]
# MAX_UPLOAD_BYTES=4294967296

# --- RTSP relay (mediamtx, started by docker compose) ---
# true: every RTSP recording/preview goes through it. false: connect straight to the camera.
RTSP_RELAY=true
# RTSP_RELAY_API=http://127.0.0.1:9997
# RTSP_RELAY_HOST=127.0.0.1
# RTSP_RELAY_PORT=8554

# --- Snapshot links (http://host/.../ch9.jpg) ---
# SNAPSHOT_MIN_INTERVAL_S=0.1
# SNAPSHOT_TIMEOUT_S=3
# SNAPSHOT_FAIL_S=15
